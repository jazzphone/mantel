# environments
.venv/
venv/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# secrets: never commit
*.token
*token*.txt
secrets/
.env
.env.*
*.pem
*.key
# ...except the secret-free templates and docs of the compose stack (packaging/compose/)
!.env.example
!packaging/compose/secrets/
packaging/compose/secrets/*
!packaging/compose/secrets/README.md

# OS / editor
.DS_Store
.idea/
.vscode/

# measurement scratch
*.tmp

# Apple-licensed files and HK snapshot/fixtures: never tracked (also enforced by tests/test_proof1_guards.py)
spikes/hk-snapshot/
**/SF-Pro*
# This existing CSS loader contains no font data; the actual fonts remain ignored.
!**/sf-pro.css
**/hk-glyphs*
# the home's own uploaded files and backups (user_files.py, backup.py): data, never source
user-files/
*.mbk

# agent worktrees
.claude/worktrees/
.claude/settings.local.json
