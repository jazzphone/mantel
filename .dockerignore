# The Docker build context is the repository root. Keep it small, and keep anything private out of it.
.git
.claude
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache
.DS_Store

# secrets and local config: never part of an image
.env
.env.*
**/secrets
*.key
*.pem
*.token
*token*.txt

# Apple-licensed fonts/glyphs and captured house data (see .gitignore); each home supplies its own
spikes
**/SF-Pro*
**/hk-glyphs*

# not needed inside the images
docs
tests
packaging/compose
packaging/lxc
packaging/ha-app
!packaging/ha-app/DOCS.md
packaging/mantel-connect
tools/headless
tools/testha
hosts/ha
# ...except HK Frontend's guide pages, which Mantel serves at /docs (the Dockerfile copies them to /app/help/hk)
!hosts/ha/custom_components/hk_frontend/docs
hosts/server/tools

# Home Assistant's side of hk_core (Mantel Link and HK Frontend vendor it); no server imports it
hk_core/link
# the build tools tools/package.json installs on a Mac (the image installs its own: the Dockerfile's esbuild stage)
tools/node_modules
