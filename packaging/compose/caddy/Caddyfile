# Mantel's Caddy (PLAN §7, §8). Mounted at /etc/caddy/Caddyfile. Settings arrive as MANTEL_* variables
# from packaging/compose/.env (no secrets there; the DNS token is read from a secret FILE below).
# Not used with "bring your own proxy" (compose.byo-proxy.yaml): there the home's own proxy does what this
# file does, and Mantel Server enforces the same rules itself (docs/phase3/PACKAGING.md).
#
# Two doors, two rule sets (PLAN §7):
#   LAN door     https://{$MANTEL_HOSTNAME}  : TLS here, published on :443. Tablets and LAN clients.
#   tunnel door  http://<tunnel-ip>:8080     : plain HTTP on the internal tunnel network ONLY, where
#                                              cloudflared is the only other container. Tunnel clients.
# Caddy stamps X-Mantel-Door on every request after deleting any value the client sent, so Mantel Server
# can tell the doors apart (wall-tablet credentials are refused on "tunnel"). Mantel Server is reachable
# only from Caddy (internal network), so it can trust that header.

{
	admin off
	# A browser sends no name (SNI) to an address, and behind Docker's port mapping Caddy can't tell which address it
	# was: without this, https://<the LXC's address> (mantel-setup's "try", MANTEL_HOSTNAME an IP) failed the handshake.
	# With a name, browsers send it and this changes nothing.
	default_sni {$MANTEL_HOSTNAME}
	# Only cloudflared (fixed address on the tunnel network) may tell us a client's real address, and it
	# says it in Cf-Connecting-Ip (set by Cloudflare's edge; a browser can't). From anyone else the client
	# is the socket's peer.
	servers {
		trusted_proxies static {$MANTEL_CLOUDFLARED_IP:172.31.250.3}
		client_ip_headers Cf-Connecting-Ip
	}
	log {
		output stdout
		format json
	}
}

# ---- shared pieces -----------------------------------------------------------------------------

(security_headers) {
	# Mantel Server sets its own Content-Security-Policy, HSTS (on https), nosniff, Referrer-Policy,
	# Permissions-Policy and frame-ancestors on every answer (hosts/server/mantel_server/security_headers.py),
	# so they hold behind any proxy (docs/phase3/PACKAGING.md "Security headers"). Caddy must NOT add a
	# second Content-Security-Policy: browsers enforce both, and Music Assistant's frame under /ma/ has its
	# own policy. Caddy only drops its own Server header.
	header {
		-Server
	}
}

(common) {
	encode zstd gzip
	import security_headers

	# Identity and routing headers that only a trusted proxy may set (HA Ingress, Mantel Connect):
	# never accepted from a browser, on either door.
	request_header -X-Remote-User-Id
	request_header -X-Remote-User-Name
	request_header -X-Remote-User-Display-Name
	request_header -X-Ingress-Path
	request_header -X-Hass-Source
	request_header -X-Mantel-Door

	# The container healthcheck talks to Mantel Server directly; the outside never sees it.
	@internal path /healthz
	respond @internal 404

	request_body {
		max_size 12MB
	}
}

# ---- LAN door -------------------------------------------------------------------------------------

{$MANTEL_HOSTNAME} {
	# TLS: DNS-01 (tls-dns01.caddy, default) or Caddy's own CA (tls-internal.caddy); chosen in .env.
	import /etc/caddy/tls.caddy
	import common
	request_header X-Mantel-Door lan
	# A Cloudflare Access assertion only means something on the tunnel door.
	request_header -Cf-Access-Jwt-Assertion
	# mantel-backend: Mantel's alias on the backend network only, so this connection always comes from
	# Caddy's fixed backend address (172.31.251.2), the one peer Mantel trusts (--trusted-proxy).
	reverse_proxy mantel-backend:8765
}

# ---- tunnel door (only reachable on the internal tunnel network) ------------------------------------

http://:8080 {
	bind {$MANTEL_CADDY_TUNNEL_IP:172.31.250.2}
	import common
	request_header X-Mantel-Door tunnel
	# Mantel takes the LAST X-Forwarded-For hop from Caddy. Appended to, that was cloudflared's own address
	# for every remote visitor (one sign-in limit shared by the whole internet); it is the client's alone.
	reverse_proxy mantel-backend:8765 {
		header_up X-Forwarded-For {client_ip}
	}
}

# ---- Caddy's own healthcheck (loopback inside the Caddy container) ----------------------------------

http://127.0.0.1:8080 {
	bind 127.0.0.1
	respond /ready 200
}
