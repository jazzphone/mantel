# LAN TLS with a real certificate via the ACME DNS-01 challenge through DigitalOcean (no inbound internet port needed).
# Needs the mantel-caddy image (packaging/docker/caddy.Dockerfile builds this provider in) and the secret file
# secrets/digitalocean_token: a DigitalOcean API token with the "domain" read and write scopes (a custom
# scoped token). Chosen with COMPOSE_FILE=compose.yaml:compose.dns-digitalocean.yaml, which mounts this file
# and that secret.
tls {
	dns digitalocean {file./run/secrets/digitalocean_token}
	resolvers 1.1.1.1
}
