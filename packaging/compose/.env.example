# Copy to .env and edit. This file holds settings only, NEVER a secret: tokens are files
# (secrets/README.md). A real .env is git-ignored; do not commit it.

# What browsers type, and the address tablets reach this host at (for WebRTC).
MANTEL_HOSTNAME=mantel.example.com
MANTEL_LAN_IP=192.0.2.10

# Home Assistant: normally set up after the first start on the admin page (/admin, Connections), which
# signs in to HA or takes a pasted token and keeps it sealed on the data volume. Optional here: an address
# plus a non-empty secrets/ha_token file is shown on that page as "set by the installation". Leave both
# empty to do it all on the page.
MANTEL_HA_URL=

# Extra Host names to accept besides MANTEL_HOSTNAME, comma separated (e.g. the LAN IP).
MANTEL_ALLOW_HOSTS=

# TLS for the LAN door: DNS-01 (needs the Cloudflare DNS token) or Caddy's own CA.
MANTEL_TLS_SNIPPET=./caddy/tls-dns01.caddy
#MANTEL_TLS_SNIPPET=./caddy/tls-internal.caddy

# Where the secret files live on this host.
MANTEL_SECRETS_DIR=/etc/hk/secrets

# Images. Production: pin by digest, e.g. ghcr.io/jazzphone/mantel-server@sha256:...
#MANTEL_SERVER_IMAGE=ghcr.io/jazzphone/mantel-server:stable
#MANTEL_TRANSCODE_IMAGE=ghcr.io/jazzphone/mantel-transcode:stable
#MANTEL_CADDY_IMAGE=ghcr.io/jazzphone/mantel-caddy:stable

# Live TV on the iGPU: uncomment both on a host with /dev/dri.
#COMPOSE_FILE=compose.yaml:compose.gpu.yaml
#MANTEL_RENDER_GID=105

# Extra origins the page may talk to or frame (CSP). Read docs/phase3/PACKAGING.md before adding any.
#MANTEL_CONNECT_SRC=
#MANTEL_FRAME_SRC=
# Show Mantel inside another page (e.g. an HA panel): the framing origin. The default forbids framing.
#MANTEL_FRAME_ANCESTORS='none'

# Only if 443 must be published on another host port.
#MANTEL_HTTPS_PORT=443

# The nightly encrypted backup: MANTEL_BACKUP_DIR is the host folder (the NAS mount), mounted at
# /backups; set MANTEL_BACKUP_TARGET=/backups to turn it on.
MANTEL_BACKUP_DIR=./backups
MANTEL_BACKUP_TARGET=
# Music Assistant: normally set up on the admin page (Connections) too. Optional here, with a non-empty
# secrets/ma_token file; empty = set it up on the page (or leave Music Assistant off).
MANTEL_MA_URL=

# Mantel Connect (Mantel in Home Assistant's sidebar and Companion app): add compose.connect.yaml, then pair with
# `docker compose exec mantel-server mantel connect pair` (docs/phase3/CONNECT.md). The address is what HA reaches.
#COMPOSE_FILE=compose.yaml:compose.connect.yaml
#MANTEL_CONNECT_ADDRESS=192.0.2.10:8766
#MANTEL_CONNECT_HOST_PORT=8766
# What the sidebar counts as: trusted (the default; HA's sign-in is enough), lan, or tunnel.
#MANTEL_HA_DOOR_RULES=trusted
