# Copy to .env and edit. This file holds settings only, NEVER a secret: tokens are files
# (secrets/README.md). A real .env is git-ignored; do not commit it.

# What browsers type, and the address tablets reach this host at (for WebRTC).
MANTEL_HOSTNAME=mantel.example.com
MANTEL_LAN_IP=192.0.2.10

# Home Assistant: normally set up after the first start on the admin page (/admin, Connections), which
# signs in to HA or takes a pasted token and keeps it sealed on the data volume. Optional here: an address
# plus a non-empty secrets/ha_token file is shown on that page as "set by the installation". Leave both
# empty to do it all on the page.
MANTEL_HA_URL=

# Extra Host names to accept besides MANTEL_HOSTNAME, comma separated (e.g. the LAN IP).
MANTEL_ALLOW_HOSTS=

# HTTPS: how browsers get a certificate (docs/OPERATIONS.md "HTTPS: four ways"). Choose ONE of A, B or C.
#
# A. Caddy's own certificate authority: no domain needed. Browsers warn until you trust its root once on each
#    device (docs/OPERATIONS.md says how). The default:
MANTEL_TLS_SNIPPET=./caddy/tls-internal.caddy
#
# B. Your own domain, with a real certificate: Caddy proves the name through your DNS host's API (DNS-01), so no
#    port is opened to the internet and the name may stay LAN-only. Put the DNS host's secret file(s) in the
#    secret folder (secrets/README.md), then set:
#      Cloudflare     MANTEL_TLS_SNIPPET=./caddy/tls-dns01-cloudflare.caddy    secret: cloudflare_dns_token
#    or, for the others, add the DNS host's compose file (it mounts its snippet and secrets; MANTEL_TLS_SNIPPET
#    is not used then):
#      Duck DNS       COMPOSE_FILE=compose.yaml:compose.dns-duckdns.yaml        secret: duckdns_token
#      Porkbun        COMPOSE_FILE=compose.yaml:compose.dns-porkbun.yaml        secrets: porkbun_api_key, porkbun_secret_api_key
#      Route 53       COMPOSE_FILE=compose.yaml:compose.dns-route53.yaml        secrets: route53_access_key_id, route53_secret_access_key
#      DigitalOcean   COMPOSE_FILE=compose.yaml:compose.dns-digitalocean.yaml   secret: digitalocean_token
#      deSEC          COMPOSE_FILE=compose.yaml:compose.dns-desec.yaml          secret: desec_token
#    (./caddy/tls-dns01.caddy, the Cloudflare snippet's older name, keeps working.)
#
# C. Your own reverse proxy (Nginx Proxy Manager, Traefik, ...) owns HTTPS instead of Caddy: add
#    compose.byo-proxy.yaml to COMPOSE_FILE, set MANTEL_TRUSTED_PROXY to its address, and make it send
#    X-Mantel-Door (docs/OPERATIONS.md has the proxy's settings):
#COMPOSE_FILE=compose.yaml:compose.byo-proxy.yaml
#MANTEL_TRUSTED_PROXY=192.0.2.20
#MANTEL_HTTP_BIND=192.0.2.10
#MANTEL_HTTP_PORT=8765
#
# Beside any of them, a Cloudflare tunnel for remote access: start with --profile tunnel (secret: cloudflared_token).

# Where the secret files live on this host.
MANTEL_SECRETS_DIR=/etc/hk/secrets

# Images. Empty: built on this host from the source (docker compose build). Published: each release is
# tagged with its version (:X.Y.Z, the same as the Home Assistant App's) and :latest follows the newest.
# The published mantel-caddy has every DNS host above built in.
# Pin one: a version, or a digest (ghcr.io/jazzphone/mantel-server@sha256:...); ./update.sh pulls what is set.
#MANTEL_SERVER_IMAGE=ghcr.io/jazzphone/mantel-server:latest
#MANTEL_TRANSCODE_IMAGE=ghcr.io/jazzphone/mantel-transcode:latest
#MANTEL_CADDY_IMAGE=ghcr.io/jazzphone/mantel-caddy:latest

# Live TV on the iGPU: uncomment both on a host with /dev/dri.
#COMPOSE_FILE=compose.yaml:compose.gpu.yaml
#MANTEL_RENDER_GID=105

# Extra origins the page may talk to or frame (CSP; Mantel sets it itself). Read docs/phase3/PACKAGING.md
# before adding any. Space or comma separated origins.
#MANTEL_CONNECT_SRC=
#MANTEL_FRAME_SRC=
# Show Mantel inside another site's page (e.g. an HA panel on another origin): that origin. By default only
# Mantel's own pages may frame it (HK Settings' preview); 'none' forbids even that.
#MANTEL_FRAME_ANCESTORS=

# Only if 443 must be published on another host port.
#MANTEL_HTTPS_PORT=443

# The nightly encrypted backup: MANTEL_BACKUP_DIR is the host folder (the NAS mount), mounted at
# /backups; set MANTEL_BACKUP_TARGET=/backups to turn it on.
MANTEL_BACKUP_DIR=./backups
MANTEL_BACKUP_TARGET=
# Music Assistant: normally set up on the admin page (Connections) too. Optional here, with a non-empty
# secrets/ma_token file; empty = set it up on the page (or leave Music Assistant off).
MANTEL_MA_URL=
# Music Assistant's web app, framed by HK through Mantel's own /ma/ (default: the host of MANTEL_MA_URL).
#MANTEL_MA_WEB_URL=http://192.0.2.30:8095/
# go2rtc's API for /go2rtc/ (viewing only); the stack's own go2rtc by default.
#MANTEL_GO2RTC_URL=http://go2rtc:1984

# Mantel Connect (Mantel in Home Assistant's sidebar and Companion app): add compose.connect.yaml, then pair with
# `docker compose exec mantel-server mantel connect pair` (docs/phase3/CONNECT.md). The address is what HA reaches.
#COMPOSE_FILE=compose.yaml:compose.connect.yaml
#MANTEL_CONNECT_ADDRESS=192.0.2.10:8766
#MANTEL_CONNECT_HOST_PORT=8766
# What the sidebar counts as: trusted (the default; HA's sign-in is enough), lan, or tunnel. Only the first start's
# value: Mantel Settings (Connections, Home Assistant, Coming Through Home Assistant) keeps it from then on.
#MANTEL_HA_DOOR_RULES=trusted

# Cloudflare Access in front of the tunnel (--profile tunnel; optional, recommended). Your Zero Trust team name
# (myteam, from myteam.cloudflareaccess.com) and the Access application's AUD tag (its Overview tab). With both set,
# Mantel refuses every tunnel request that does not carry a valid Access assertion. Neither is a secret.
#MANTEL_CF_ACCESS_TEAM=myteam
#MANTEL_CF_ACCESS_AUD=

# The kill switch: 1 keeps the house read-only whatever Mantel Settings says (General, Allow Control of the House,
# which an Owner turns on there). Leave it unset normally.
#MANTEL_READ_ONLY=1
